{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicAvailabilityResponse",
  "description": "Strict allowlist contract for GET /api/availability (SEC-003). Zero tenant PII or internal lease/maintenance notes allowed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "summary", "floors"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_in", "rent_type", "duration_qty", "generated_at"],
      "properties": {
        "check_in": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "rent_type": { "type": "string", "enum": ["daily", "weekly", "monthly"] },
        "duration_qty": { "type": "integer", "minimum": 1 },
        "generated_at": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_rooms", "available", "booked", "occupied", "maintenance"],
      "properties": {
        "total_rooms": { "type": "integer", "enum": [32] },
        "available": { "type": "integer", "minimum": 0 },
        "booked": { "type": "integer", "minimum": 0 },
        "occupied": { "type": "integer", "minimum": 0 },
        "maintenance": { "type": "integer", "minimum": 0 }
      }
    },
    "floors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["1", "2"],
      "properties": {
        "1": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id", "code", "floor", "grid_row", "grid_col",
              "room_type_id", "room_type_slug", "room_class", "room_class_label",
              "status", "status_label", "is_selectable", "rates"
            ],
            "properties": {
              "id": { "type": "integer", "minimum": 1 },
              "code": { "type": "string", "pattern": "^1(0[1-9]|1[0-6])$" },
              "floor": { "type": "integer", "enum": [1] },
              "grid_row": { "type": "integer", "enum": [1, 2] },
              "grid_col": { "type": "integer", "minimum": 1 },
              "room_type_id": { "type": "integer", "enum": [1, 2, 3] },
              "room_type_slug": { "type": "string", "enum": ["standard", "vip", "deluxe"] },
              "room_class": { "type": "string", "enum": ["standard", "vip", "deluxe"] },
              "room_class_label": { "type": "string", "enum": ["Standard", "VIP", "Deluxe"] },
              "status": { "type": "string", "enum": ["available", "booked", "occupied", "maintenance"] },
              "status_label": { "type": "string", "enum": ["Tersedia", "Dipesan (DP)", "Terisi", "Perbaikan"] },
              "is_selectable": { "type": "boolean" },
              "rates": {
                "type": "object",
                "additionalProperties": false,
                "required": ["daily", "weekly", "monthly"],
                "properties": {
                  "daily": { "type": "integer", "minimum": 1 },
                  "weekly": { "type": "integer", "minimum": 1 },
                  "monthly": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        },
        "2": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id", "code", "floor", "grid_row", "grid_col",
              "room_type_id", "room_type_slug", "room_class", "room_class_label",
              "status", "status_label", "is_selectable", "rates"
            ],
            "properties": {
              "id": { "type": "integer", "minimum": 1 },
              "code": { "type": "string", "pattern": "^2(0[1-9]|1[0-6])$" },
              "floor": { "type": "integer", "enum": [2] },
              "grid_row": { "type": "integer", "enum": [1, 2] },
              "grid_col": { "type": "integer", "minimum": 1 },
              "room_type_id": { "type": "integer", "enum": [1, 2, 3] },
              "room_type_slug": { "type": "string", "enum": ["standard", "vip", "deluxe"] },
              "room_class": { "type": "string", "enum": ["standard", "vip", "deluxe"] },
              "room_class_label": { "type": "string", "enum": ["Standard", "VIP", "Deluxe"] },
              "status": { "type": "string", "enum": ["available", "booked", "occupied", "maintenance"] },
              "status_label": { "type": "string", "enum": ["Tersedia", "Dipesan (DP)", "Terisi", "Perbaikan"] },
              "is_selectable": { "type": "boolean" },
              "rates": {
                "type": "object",
                "additionalProperties": false,
                "required": ["daily", "weekly", "monthly"],
                "properties": {
                  "daily": { "type": "integer", "minimum": 1 },
                  "weekly": { "type": "integer", "minimum": 1 },
                  "monthly": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        }
      }
    }
  }
}
